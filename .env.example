# 이 파일은 "어떤 값이 필요한지" 보여주는 견본입니다. 실제 값은 .env.local 에 넣으세요.
# .env.local 은 git에 올라가지 않습니다.

# Supabase > Project Settings > Data API 의 Project URL
SUPABASE_URL=

# Supabase > Project Settings > API Keys > Secret keys (sb_secret_ 로 시작)
# 절대 외부에 공유하지 마세요. 서버에서만 사용됩니다.
SUPABASE_SECRET_KEY=

# 관리자 로그인 비밀번호 (직접 정하세요. 12자 이상 권장)
ADMIN_PASSWORD=

# QR 토큰·입장권·관리자 세션 서명용 무작위 문자열 (32자 이상)
# npm run gen-secret 으로 .env.local 에 자동 생성됩니다.
APP_SECRET=
